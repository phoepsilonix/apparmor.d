abi <abi/5.0>,

include <tunables/global>

@{name} = claude-desktop
@{domain} = org.chromium.Chromium
@{lib_dirs} = @{lib}/@{name}/
@{config_dirs} = @{user_config_dirs}/Claude
@{cache_dirs} = @{user_cache_dirs}/Claude

profile claude-cowork-vm {
  include <abstractions/base>
  include <abstractions/nameservice-strict>

  network inet dgram,
  network inet6 dgram,
  network inet stream,
  network inet6 stream,
  network netlink raw,

  unix (send receive) type=stream peer=(label=virtiofsd),

  @{bin}/qemu-system* mr,

  @{lib_dirs}/resources/smol-bin.x64.img k,

  /usr/share/qemu/{,**} r,

  /etc/libnl/classid r,

  owner @{config_dirs}/ r,
  owner @{config_dirs}/** rwk,

  owner @{run}/user/@{uid}/cowork-vm-@{int}/qmp.sock w,
  owner @{run}/user/@{uid}/cowork-vm-@{int}/virtiofsd-0.sock rw,

  @{sys}/devices/system/node/ r,
  @{sys}/devices/system/node/node@{int}/meminfo r,

  @{sys}/module/*/uevent r,
  @{sys}/module/kvm_*/parameters/* r,
  @{sys}/module/vhost/parameters/max_mem_regions r,

  @{PROC}/sys/vm/max_map_count r,

  /dev/kvm rw,
  /dev/vhost-vsock rw,

  # file_inherit
  deny owner /dev/shm/.@{domain}.@{rand6} rw,

  include if exists <local/claude-cowork-vm>
}

# vim:syntax=apparmor
